@@ -295,6 +295,18 @@ def withGates (c : RawCircuit) (gs : List Gate) : RawCircuit where
   hasCcz := gs.any Gate.isCcz
   hasMeasurement := gs.any Gate.isMeasurement
 
+/-- Transform the gate list after extracting the register sizes. Unlike
+`c.withGates (f c.numQubits c.gates)`, this releases the old circuit before
+calling `f`, allowing an exclusively owned gate list to be reused. -/
+@[inline] def mapGates (c : RawCircuit) (f : Nat → List Gate → List Gate) : RawCircuit :=
+  let n := c.numQubits
+  let m := c.numCbits
+  let gs := c.gates
+  ofGates n m (f n gs)
+
+theorem mapGates_eq_withGates (c : RawCircuit) (f : Nat → List Gate → List Gate) :
+    c.mapGates f = c.withGates (f c.numQubits c.gates) := rfl
+
 @[simp] theorem gates_withGates (c : RawCircuit) (gs : List Gate) : (c.withGates gs).gates = gs := rfl
 
 @[simp] theorem numQubits_withGates (c : RawCircuit) (gs : List Gate) :
