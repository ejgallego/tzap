+/-- The count is a separate argument so the compiler cannot defer its computation
+until after `p.run` and retain the input circuit. Reuse the output count next round. -/
+@[noinline] private def runFixpointShrinkLoop (p : ExecutableRandPass) :
+    Nat → Nat → Circuit n m → IO (Circuit n m)
+  | 0, _, c => pure c
+  | fuel + 1, before, c => do
+      let out ← p.run c
+      let after := out.raw.gates.length
+      if after < before then runFixpointShrinkLoop p fuel after out else pure out
+
+private theorem runFixpointShrinkLoop_eq (p : ExecutableRandPass) (fuel : Nat)
+    (c : Circuit n m) :
+    runFixpointShrinkLoop p fuel c.raw.gates.length c = (p.fixpointShrink fuel).run c := by
+  induction fuel generalizing c with
+  | zero => rfl
+  | succ fuel ih => simp [runFixpointShrinkLoop, fixpointShrink, compWhen, ih]
+
+/-- Execute only the shrinking fixpoint rounds that run. Zero fuel neither scans
+the gate list nor invokes the pass. The pass's IO effects remain in execution order. -/
+def runFixpointShrink (p : ExecutableRandPass) : Nat → Circuit n m → IO (Circuit n m)
+  | 0, c => pure c
+  | fuel + 1, c => runFixpointShrinkLoop p (fuel + 1) c.raw.gates.length c
+
+theorem runFixpointShrink_eq (p : ExecutableRandPass) (fuel : Nat) (c : Circuit n m) :
+    p.runFixpointShrink fuel c = (p.fixpointShrink fuel).run c := by
+  cases fuel with
+  | zero => rfl
+  | succ fuel => exact runFixpointShrinkLoop_eq p (fuel + 1) c
+
 end ExecutableRandPass
 
 end TzapLean
